{
  "name": "rust-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cargo watch -x run",
    "build": "cargo build",
    "lint": "cargo clippy",
    "test": "cargo test",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d postgres",
    "db:status": "docker-compose ps postgres"
  }
}
